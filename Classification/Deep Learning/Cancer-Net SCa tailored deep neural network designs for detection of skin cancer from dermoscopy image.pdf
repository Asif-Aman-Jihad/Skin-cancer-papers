         <sn:authorInfo>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <author:name>Dongming Liu</author:name>
                  <author:orcid>http://orcid.org/0000-0002-1883-2281</author:orcid>
               </rdf:li>
            </rdf:Bag>
